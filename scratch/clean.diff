+// ΓöÇΓöÇΓöÇ Flash Notification ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+const flashMsg = ref(props.flash?.success || props.flash?.error || '');
+const flashType = ref(props.flash?.error ? 'error' : 'success');
+let flashTimer = null;
+const progressWidth = ref(100);
+const flashDuration = ref(4000);
+
+function clearFlashTimer() {
+    if (flashTimer) {
+        clearTimeout(flashTimer);
+        flashTimer = null;
+    }
+}
+
+function closeFlash() {
+    clearFlashTimer();
+    flashMsg.value = '';
+}
+
+function showFlash(msg, type = 'success', duration = 4000) {
+    clearFlashTimer();
+    flashMsg.value = msg;
+    flashType.value = type;
+    flashDuration.value = duration;
+    
+    progressWidth.value = 100;
+    setTimeout(() => {
+        if (flashMsg.value === msg) {
+            progressWidth.value = 0;
+        }
+    }, 50);
+
+    flashTimer = setTimeout(() => {
+        flashMsg.value = '';
+        flashTimer = null;
+    }, duration);
+}
+
+// Watch props.flash if updated via Inertia visit / redirect
+watch(() => props.flash, (newFlash) => {
+    if (newFlash?.success) {
+        showFlash(newFlash.success, 'success', 4000);
+    } else if (newFlash?.error) {
+        showFlash(newFlash.error, 'error', 4000);
+    }
+}, { deep: true });
+
+onMounted(() => {
+    if (flashMsg.value) {
+        flashDuration.value = 4000;
+        progressWidth.value = 100;
+        setTimeout(() => {
+            progressWidth.value = 0;
+        }, 50);
+
+        flashTimer = setTimeout(() => {
+            flashMsg.value = '';
+            flashTimer = null;
+        }, 4000);
+    }
+});
+
+onUnmounted(() => {
+    clearFlashTimer();
+});
+
+</script>
